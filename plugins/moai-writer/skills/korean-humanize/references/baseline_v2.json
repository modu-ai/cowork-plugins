  "axis_definitions": {
    "simplification": {
      "source": "Toral 2019; 보고서 line 351",
      "metrics": [
        "lexical_diversity_ttr",
        "lexical_density",
        "ending_diversity"
      ],
      "interpretation": "low values → AI-like (repetition, function-word heavy, monotonic endings)"
    },
    "normalisation": {
      "source": "Baker 1993; 보고서 line 352",
      "metrics": [
        "normalisation_score",
        "da_streak_rate"
      ],
      "interpretation": "high values → AI-like (-한다/-된다/-이다 concentration, '-다' streak runs)"
    },
    "interference": {
      "source": "Toury 1995 law of interference; 보고서 line 353",
      "metrics": [
        "inanimate_subject_rate",
        "by_passive_count",
        "double_passive_count",
        "pronoun_density",
        "deul_overuse_rate",
        "relative_clause_nesting",
        "have_make_literal_count",
        "double_particle_count",
        "progressive_aspect_rate"
      ],
      "interpretation": "high values → AI-like (영어 통사 보존)"
    },
    "copy_interference": {
      "source": "한국어 카피 장르 실전 관찰 — ai-tell-taxonomy.md A-20~A-25·I-7 + content-copywriting/ai-tell-ko-copy-spec.md §1",
      "metrics": [
        "mechanical_verb_calque_count",
        "abstract_noun_ending_count",
        "benefactive_calque_count",
        "sentence_initial_deuneun_count",
        "first_person_formal_count"
      ],
      "interpretation": "high values → AI-like (영어 카피 직역). z-score 미산출 — 원값 + copy_interference_index 합성만 보고"
    }
  },
  "z_score_thresholds": {
    "comments": "v1.6 thresholds(z>1.0 가산)를 그대로 계승한다. v2.0 placeholder 셀은 calibration 완료 후 본진 baseline.json에 병합한다."
  },
  "sd_provenance": "[중요] 모든 stdev는 추정치다. 원 연구는 평균과 로그우도 G²만 보고했고 분산은 보고하지 않았다. calibration이 'measured_mean_estimated_sd'인 셀은 **평균만 실측**이며, 그 위에 세운 z는 지시적 수치이지 정밀값이 아니다.",
  "v2_4_note": "v2.4에서 실증 대조 코퍼스 기반 셀 3종(antithesis_count · long_sentence_rate · geosida_rate)을 추가했다. 기존 셀은 전부 _placeholder: true(미보정) 상태를 유지한다."
}